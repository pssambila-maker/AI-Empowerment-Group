# ─────────────────────────────────────────────────────────────────
# Cloud Functions — string parameters (firebase-functions params).
# Copy to .env (or .env.<project-id>) before deploying.
#
# Secrets are NOT set here. Set them with the Firebase CLI:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# ─────────────────────────────────────────────────────────────────

# Stripe Price ID for the $750/week training subscription
# (Stripe Dashboard → Products → AI Empowerment Training → Pricing)
STRIPE_PRICE_ID=price_XXXXXX

# Public origin used for Checkout redirect URLs
SITE_URL=https://aiempowermentgroup.com
