---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist or has moved.">
  <main class="notfound-page" aria-label="Page not found">
    <div class="notfound-card">
      <div class="notfound-code" aria-hidden="true">404</div>
      <h1>Page Not Found</h1>
      <p>The page you're looking for doesn't exist, may have moved, or the link may be out of date. Let's get you back on track.</p>
      <div class="notfound-actions">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/services" class="btn-ghost">View Services</a>
        <a href="/assessment" class="btn-ghost">Take the Free Assessment</a>
        <a href="/contact" class="btn-ghost">Contact Us</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .notfound-page { min-height: calc(100vh - 68px); display: grid; place-items: center; padding: 2rem; background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(201,168,76,0.06) 0%, transparent 70%), var(--color-charcoal); }
  .notfound-card { max-width: 520px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .notfound-code { font-family: var(--font-heading); font-size: clamp(3rem, 8vw, 4.5rem); font-weight: 800; color: var(--color-gold); letter-spacing: 0.05em; line-height: 1; opacity: 0.85; }
  h1 { font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--color-off-white); }
  p { font-size: 1rem; color: rgba(245,245,240,0.6); line-height: 1.7; }
  .notfound-actions { display: flex; gap: 0.75rem 1.5rem; flex-wrap: wrap; justify-content: center; margin-top: 0.5rem; }
  .btn-primary { display: inline-flex; align-items: center; background: var(--color-gold); color: var(--color-charcoal); font-family: var(--font-heading); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.05em; text-transform: uppercase; padding: 0.8rem 1.75rem; border-radius: 4px; text-decoration: none; transition: filter 0.15s, transform 0.15s; }
  .btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); text-decoration: none; }
  .btn-ghost { display: inline-flex; align-items: center; color: var(--color-mid-grey); font-size: 0.875rem; text-decoration: underline; text-underline-offset: 3px; }
  .btn-ghost:hover { color: var(--color-off-white); }
</style>
