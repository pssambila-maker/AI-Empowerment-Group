---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin" description="Owner-only dashboard.">

  <div id="state-loading" class="full-center">
    <div class="spinner" aria-label="Loading"></div>
    <p>Loading&hellip;</p>
  </div>

  <div id="state-denied" class="full-center" hidden>
    <h1>Not Authorized</h1>
    <p class="sub-text">This page is restricted to the site owner.</p>
    <a href="/" class="btn-ghost">Back to Home</a>
  </div>

  <main id="state-admin" class="admin-page" hidden>
    <header class="admin-header">
      <h1>Admin</h1>
      <button type="button" id="refresh-btn" class="btn-ghost">&#x21bb; Refresh</button>
    </header>

    <section class="admin-section">
      <h2>Free Class Schedule</h2>
      <form id="schedule-form" class="schedule-form">
        <div class="field-group">
          <label for="schedule-date">Date</label>
          <input type="date" id="schedule-date" required />
        </div>
        <div class="field-group">
          <label for="schedule-start">Start time</label>
          <input type="time" id="schedule-start" required />
        </div>
        <div class="field-group">
          <label for="schedule-end">End time</label>
          <input type="time" id="schedule-end" required />
        </div>
        <div class="field-group field-group--wide">
          <label for="schedule-link">Join link</label>
          <input type="url" id="schedule-link" placeholder="https://zoom.us/..." required />
        </div>
        <button type="submit" id="schedule-save-btn" class="csv-btn schedule-save-btn">Save</button>
        <span id="schedule-status" class="schedule-status" aria-live="polite"></span>
      </form>
      <p class="empty-note">Times are Eastern (ET) — this is what the assessment funnel and class-invite emails show. Editing this here takes effect immediately, no redeploy needed.</p>
    </section>

    <section class="admin-section">
      <h2>
        Assessment Leads <span id="leads-count" class="count-badge"></span>
        <button type="button" id="leads-csv-btn" class="csv-btn">Download CSV</button>
      </h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Date</th><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Score</th><th>Category</th></tr>
          </thead>
          <tbody id="leads-body"></tbody>
        </table>
        <p id="leads-empty" class="empty-note" hidden>No assessment leads yet.</p>
      </div>
    </section>

    <section class="admin-section">
      <h2>
        Class Registrations <span id="registrations-count" class="count-badge"></span>
        <button type="button" id="registrations-csv-btn" class="csv-btn">Download CSV</button>
      </h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Registered</th><th>Name</th><th>Email</th><th>Score</th><th>Role</th><th>Class Date</th></tr>
          </thead>
          <tbody id="registrations-body"></tbody>
        </table>
        <p id="registrations-empty" class="empty-note" hidden>No class registrations yet.</p>
      </div>
    </section>

    <section class="admin-section">
      <h2>
        Contact Inquiries <span id="inquiries-count" class="count-badge"></span>
        <button type="button" id="inquiries-csv-btn" class="csv-btn">Download CSV</button>
      </h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Date</th><th>Name</th><th>Email</th><th>Country</th><th>Inquiry</th><th>Message</th></tr>
          </thead>
          <tbody id="inquiries-body"></tbody>
        </table>
        <p id="inquiries-empty" class="empty-note" hidden>No contact inquiries yet.</p>
      </div>
    </section>
  </main>

</Layout>

<script>
  import { onAuthStateChanged } from "firebase/auth";
  import { getFirebaseAuth, getFirebaseDb } from "../lib/firebase/client";
  import {
    fetchLeads,
    fetchClassRegistrations,
    fetchContactSubmissions,
    type LeadRow,
    type ClassRegistrationRow,
    type ContactSubmissionRow,
  } from "../lib/admin/data";
  import { toCsv } from "../lib/admin/csv";
  import { ADMIN_EMAIL } from "../config/admin";
  import { fetchClassSchedule, saveClassSchedule } from "../lib/assessment/classSchedule";
  import type { ClassSchedule } from "../lib/assessment/calendar";

  const auth = getFirebaseAuth();
  const db = getFirebaseDb();

  type State = "loading" | "denied" | "admin";
  function show(state: State) {
    (["loading", "denied", "admin"] as State[]).forEach((s) => {
      const el = document.getElementById(`state-${s}`) as HTMLElement;
      if (el) el.hidden = s !== state;
    });
  }

  function esc(value: string): string {
    return value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function fmtDate(d: Date | null): string {
    if (!d) return "—";
    return d.toLocaleString([], { dateStyle: "medium", timeStyle: "short" });
  }

  function downloadCsv(filename: string, content: string) {
    const blob = new Blob([content], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  let latestLeads: LeadRow[] = [];
  let latestRegistrations: ClassRegistrationRow[] = [];
  let latestInquiries: ContactSubmissionRow[] = [];

  async function loadData() {
    const [leads, registrations, inquiries] = await Promise.all([
      fetchLeads(db),
      fetchClassRegistrations(db),
      fetchContactSubmissions(db),
    ]);
    latestLeads = leads;
    latestRegistrations = registrations;
    latestInquiries = inquiries;

    const leadsBody = document.getElementById("leads-body") as HTMLElement;
    leadsBody.innerHTML = leads
      .map(
        (l) =>
          `<tr><td>${fmtDate(l.createdAt)}</td><td>${esc(l.fullName)}</td><td>${esc(l.email)}</td><td>${esc(l.phone)}</td><td>${esc(l.role)}</td><td>${l.score}</td><td>${esc(l.category)}</td></tr>`,
      )
      .join("");
    (document.getElementById("leads-count") as HTMLElement).textContent = `(${leads.length})`;
    (document.getElementById("leads-empty") as HTMLElement).hidden = leads.length > 0;

    const regBody = document.getElementById("registrations-body") as HTMLElement;
    regBody.innerHTML = registrations
      .map(
        (r) =>
          `<tr><td>${fmtDate(r.registeredAt)}</td><td>${esc(r.fullName)}</td><td>${esc(r.email)}</td><td>${r.score}</td><td>${esc(r.role)}</td><td>${r.classDate ? new Date(r.classDate).toLocaleDateString() : "—"}</td></tr>`,
      )
      .join("");
    (document.getElementById("registrations-count") as HTMLElement).textContent = `(${registrations.length})`;
    (document.getElementById("registrations-empty") as HTMLElement).hidden = registrations.length > 0;

    const inqBody = document.getElementById("inquiries-body") as HTMLElement;
    inqBody.innerHTML = inquiries
      .map(
        (i) =>
          `<tr><td>${fmtDate(i.createdAt)}</td><td>${esc(i.name)}</td><td>${esc(i.email)}</td><td>${esc(i.country)}</td><td>${esc(i.inquiry)}</td><td class="msg-cell">${esc(i.message)}</td></tr>`,
      )
      .join("");
    (document.getElementById("inquiries-count") as HTMLElement).textContent = `(${inquiries.length})`;
    (document.getElementById("inquiries-empty") as HTMLElement).hidden = inquiries.length > 0;
  }

  let currentSchedule: ClassSchedule | null = null;

  function pad(n: number): string {
    return String(n).padStart(2, "0");
  }

  async function loadSchedule() {
    currentSchedule = await fetchClassSchedule(db);
    const s = currentSchedule;
    (document.getElementById("schedule-date") as HTMLInputElement).value =
      `${s.year}-${pad(s.month)}-${pad(s.day)}`;
    (document.getElementById("schedule-start") as HTMLInputElement).value = `${pad(s.startHour)}:${pad(s.startMinute)}`;
    (document.getElementById("schedule-end") as HTMLInputElement).value = `${pad(s.endHour)}:${pad(s.endMinute)}`;
    (document.getElementById("schedule-link") as HTMLInputElement).value = s.joinLink;
  }

  document.getElementById("schedule-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!currentSchedule) return;

    const dateVal = (document.getElementById("schedule-date") as HTMLInputElement).value;
    const startVal = (document.getElementById("schedule-start") as HTMLInputElement).value;
    const endVal = (document.getElementById("schedule-end") as HTMLInputElement).value;
    const linkVal = (document.getElementById("schedule-link") as HTMLInputElement).value.trim();

    const [year, month, day] = dateVal.split("-").map(Number);
    const [startHour, startMinute] = startVal.split(":").map(Number);
    const [endHour, endMinute] = endVal.split(":").map(Number);

    const updated: ClassSchedule = {
      ...currentSchedule, // preserves timezone/timezoneLabel/title/description/location
      year, month, day,
      startHour, startMinute,
      endHour, endMinute,
      joinLink: linkVal,
    };

    const btn = document.getElementById("schedule-save-btn") as HTMLButtonElement;
    const status = document.getElementById("schedule-status") as HTMLElement;
    btn.disabled = true;
    status.textContent = "";

    try {
      await saveClassSchedule(db, updated);
      currentSchedule = updated;
      status.textContent = "Saved.";
      status.style.color = "var(--color-success, #2D7D32)";
    } catch (err) {
      console.error("Failed to save class schedule:", err);
      status.textContent = "Failed to save — check the console.";
      status.style.color = "var(--color-error, #CC3333)";
    } finally {
      btn.disabled = false;
    }
  });

  document.getElementById("refresh-btn")?.addEventListener("click", () => {
    void loadData();
    void loadSchedule();
  });

  document.getElementById("leads-csv-btn")?.addEventListener("click", () => {
    const csv = toCsv(latestLeads, [
      { key: "createdAt", label: "Date", format: (v) => fmtDate(v as Date | null) },
      { key: "fullName", label: "Name" },
      { key: "email", label: "Email" },
      { key: "phone", label: "Phone" },
      { key: "role", label: "Role" },
      { key: "score", label: "Score" },
      { key: "category", label: "Category" },
    ]);
    downloadCsv(`leads-${Date.now()}.csv`, csv);
  });

  document.getElementById("registrations-csv-btn")?.addEventListener("click", () => {
    const csv = toCsv(latestRegistrations, [
      { key: "registeredAt", label: "Registered", format: (v) => fmtDate(v as Date | null) },
      { key: "fullName", label: "Name" },
      { key: "email", label: "Email" },
      { key: "score", label: "Score" },
      { key: "role", label: "Role" },
      { key: "classDate", label: "Class Date", format: (v) => (v ? new Date(v as string).toLocaleDateString() : "—") },
    ]);
    downloadCsv(`class-registrations-${Date.now()}.csv`, csv);
  });

  document.getElementById("inquiries-csv-btn")?.addEventListener("click", () => {
    const csv = toCsv(latestInquiries, [
      { key: "createdAt", label: "Date", format: (v) => fmtDate(v as Date | null) },
      { key: "name", label: "Name" },
      { key: "email", label: "Email" },
      { key: "country", label: "Country" },
      { key: "inquiry", label: "Inquiry" },
      { key: "message", label: "Message" },
    ]);
    downloadCsv(`contact-inquiries-${Date.now()}.csv`, csv);
  });

  onAuthStateChanged(auth, async (user) => {
    if (!user) {
      window.location.href = "/login?redirect=/admin";
      return;
    }
    if (user.email !== ADMIN_EMAIL) {
      show("denied");
      return;
    }
    show("admin");
    try {
      await Promise.all([loadData(), loadSchedule()]);
    } catch (err) {
      console.error("Failed to load admin data:", err);
    }
  });
</script>

<style>
  .full-center {
    min-height: calc(100vh - 68px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
    background: var(--color-charcoal);
  }

  .full-center h1 { font-family: var(--font-heading); font-size: 1.75rem; color: var(--color-gold); }
  .sub-text { color: rgba(245,245,240,0.65); }

  .spinner {
    width: 32px; height: 32px;
    border: 3px solid rgba(201,168,76,0.2);
    border-top-color: var(--color-gold);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .btn-ghost {
    color: var(--color-mid-grey);
    font-size: 0.875rem;
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
  }
  .btn-ghost:hover { color: var(--color-gold); }

  .admin-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .admin-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .admin-header h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-gold);
  }

  .admin-section h2 {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-off-white);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .count-badge {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-mid-grey);
  }

  .csv-btn {
    margin-left: auto;
    background: none;
    border: 1px solid rgba(201,168,76,0.35);
    border-radius: 4px;
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .csv-btn:hover:not(:disabled) { background: rgba(201,168,76,0.08); }
  .csv-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .table-wrap {
    background: #1e1e1e;
    border: 1px solid rgba(245,245,240,0.08);
    border-radius: 8px;
    overflow-x: auto;
  }

  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }

  th, td {
    padding: 0.7rem 1rem;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid rgba(245,245,240,0.06);
  }

  .msg-cell { white-space: normal; max-width: 22rem; }

  th {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
    background: rgba(201,168,76,0.05);
  }

  td { color: rgba(245,245,240,0.85); }

  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: rgba(245,245,240,0.02); }

  .empty-note { padding: 1.25rem; color: var(--color-mid-grey); font-size: 0.875rem; }

  .schedule-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
    background: #1e1e1e;
    border: 1px solid rgba(245,245,240,0.08);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .schedule-form .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .schedule-form .field-group--wide { flex: 1; min-width: 14rem; }

  .schedule-form label {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-mid-grey);
  }

  .schedule-form input {
    background: var(--color-charcoal);
    border: 1.5px solid rgba(245,245,240,0.12);
    border-radius: 4px;
    color: var(--color-off-white);
    font-size: 0.9375rem;
    padding: 0.55rem 0.75rem;
  }

  .schedule-form input:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .schedule-save-btn {
    margin-left: 0;
    height: 2.4rem;
  }

  .schedule-status {
    font-size: 0.8125rem;
    font-weight: 600;
  }
</style>
