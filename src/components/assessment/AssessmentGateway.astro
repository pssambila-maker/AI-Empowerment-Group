---
// Step 0 — choose Individual vs Enterprise assessment path.
---

<section id="assessment-gateway" class="gateway">
  <div class="gateway-grid">

    <button type="button" id="gateway-individual" class="gateway-card" data-role="individual">
      <span class="gateway-tag">Personal Assessment</span>
      <h3>I&rsquo;m an Individual</h3>
      <p>Freelancers, coaches, consultants, solopreneurs</p>
      <span class="gateway-cta">Get My Score &rarr;</span>
    </button>

    <div class="gateway-divider" aria-hidden="true"><span>OR</span></div>

    <button type="button" id="gateway-enterprise" class="gateway-card" data-role="enterprise">
      <span class="gateway-tag gateway-tag--teal">Enterprise Assessment</span>
      <h3>I&rsquo;m an Enterprise</h3>
      <p>Teams, businesses, organizations, corporations</p>
      <span class="gateway-cta">Start Assessment &rarr;</span>
    </button>

  </div>
</section>

<style>
  .gateway {
    background: #1e1e1e;
    border: 1px solid rgba(245,245,240,0.08);
    border-radius: 8px;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .gateway-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (max-width: 760px) {
    .gateway-grid { grid-template-columns: 1fr; }
    .gateway-divider { display: none; }
  }

  .gateway-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 2rem 1.5rem;
    background: var(--color-charcoal);
    border: 1px solid rgba(245,245,240,0.1);
    border-radius: 8px;
    color: var(--color-off-white);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
    font-family: var(--font-body);
  }

  .gateway-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }

  .gateway-tag {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid rgba(201,168,76,0.3);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
  }

  .gateway-tag--teal {
    color: #4FD1C5;
    border-color: rgba(79,209,197,0.35);
  }

  .gateway-card h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
  }

  .gateway-card p {
    font-size: 0.9375rem;
    color: rgba(245,245,240,0.6);
    max-width: 22rem;
  }

  .gateway-cta {
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }

  .gateway-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1px;
    background: rgba(245,245,240,0.08);
    position: relative;
  }

  .gateway-divider span {
    position: absolute;
    background: #1e1e1e;
    border: 1px solid rgba(245,245,240,0.1);
    border-radius: 999px;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgba(245,245,240,0.5);
  }
</style>
