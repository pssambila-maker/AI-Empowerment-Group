---
// Step 2 — collect name & optional phone (email is pre-filled from sign-in).
---

<section id="assessment-profile-form" class="profile-form" hidden>
  <span class="step-tag">Step 1 of 3 &mdash; Your Profile</span>

  <h3>Tell Us About Yourself</h3>
  <p class="muted">We&rsquo;ll personalise your scorecard results based on your profile.</p>

  <div class="field-group">
    <label for="profile-fullname">Full Name <span class="required">*</span></label>
    <input type="text" id="profile-fullname" autocomplete="name" placeholder="e.g. Sarah Johnson" />
    <span id="profile-name-error" class="field-error" role="alert" hidden>Please enter your full name.</span>
  </div>

  <div class="field-group">
    <label for="profile-email">Email Address</label>
    <input type="email" id="profile-email" readonly />
  </div>

  <div class="field-group">
    <label for="profile-phone">Phone Number <span class="optional">Optional</span></label>
    <input type="text" id="profile-phone" autocomplete="tel" placeholder="+1 (555) 000-0000" />
  </div>

  <button type="button" id="profile-submit-btn" class="primary-btn">Start My Assessment &rarr;</button>
</section>

<style>
  .profile-form {
    max-width: 32rem;
    margin: 0 auto;
    background: #1e1e1e;
    border: 1px solid rgba(245,245,240,0.08);
    border-radius: 8px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .step-tag {
    align-self: flex-start;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid rgba(201,168,76,0.3);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
  }

  .profile-form h3 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-off-white);
  }

  .muted { color: rgba(245,245,240,0.6); font-size: 0.9375rem; margin-top: -0.75rem; }

  .field-group { display: flex; flex-direction: column; gap: 0.4rem; }

  label {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(245,245,240,0.8);
  }

  .required { color: var(--color-gold); margin-left: 2px; }
  .optional {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: rgba(245,245,240,0.45);
    border: 1px solid rgba(245,245,240,0.12);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    margin-left: 0.5rem;
    text-transform: uppercase;
    vertical-align: middle;
  }

  input {
    background: var(--color-charcoal);
    border: 1.5px solid rgba(245,245,240,0.12);
    border-radius: 4px;
    color: var(--color-off-white);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.8rem 1rem;
    width: 100%;
  }

  input:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(201,168,76,0.12);
  }

  input.invalid { border-color: var(--color-error); }

  input[readonly] {
    color: rgba(245,245,240,0.5);
    cursor: not-allowed;
  }

  .field-error { font-size: 0.8125rem; color: var(--color-error); min-height: 1.1em; }

  .primary-btn {
    background: var(--color-gold);
    color: var(--color-charcoal);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    border-radius: 4px;
    padding: 0.9rem 1.5rem;
    cursor: pointer;
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  .primary-btn:hover:not(:disabled) { filter: brightness(1.1); transform: translateY(-1px); }
</style>
