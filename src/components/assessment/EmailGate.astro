---
// Step 1 — collect email & send a Firebase email-link sign-in link.
---

<section id="assessment-email-gate" class="email-gate" hidden>
  <button type="button" id="email-gate-back" class="back-link">&larr; Back</button>

  <div class="email-card">
    <span id="email-gate-badge" class="badge">Personal Assessment</span>
    <h3 id="email-gate-title">Verify your email to begin</h3>
    <p id="email-gate-subtitle" class="muted">
      Enter your email address &mdash; we&rsquo;ll send you a secure sign-in link to continue your assessment.
    </p>

    <div id="email-gate-form" class="field-group">
      <label for="assessment-email">Email Address</label>
      <input type="email" id="assessment-email" autocomplete="email" placeholder="you@email.com" />
      <span id="assessment-email-error" class="field-error" role="alert" hidden>
        Please enter a valid email address.
      </span>
      <button type="button" id="send-link-btn" class="primary-btn">Send Sign-In Link &rarr;</button>
    </div>

    <div id="email-gate-sent" class="sent-message" hidden>
      <p>
        Check your inbox at <strong id="sent-email-display"></strong> and click the link to continue
        your assessment. You can close this tab.
      </p>
      <button type="button" id="resend-link-btn" class="text-btn">Resend link</button>
      <span id="resend-status" class="muted small" aria-live="polite"></span>
    </div>

    <div id="email-gate-error" class="form-banner form-banner--error" role="alert" hidden></div>
  </div>
</section>

<style>
  .email-gate {
    max-width: 28rem;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    color: rgba(245,245,240,0.6);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    cursor: pointer;
    margin-bottom: 1.25rem;
  }

  .back-link:hover { color: var(--color-gold); }

  .email-card {
    background: #1e1e1e;
    border: 1px solid rgba(245,245,240,0.08);
    border-radius: 8px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
  }

  .badge {
    display: inline-flex;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid rgba(201,168,76,0.3);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .badge--teal { color: #4FD1C5; border-color: rgba(79,209,197,0.35); }

  .email-card h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-off-white);
  }

  .muted { color: rgba(245,245,240,0.6); }
  .small { font-size: 0.8125rem; }

  .email-card p { margin-top: 0.5rem; font-size: 0.9375rem; line-height: 1.6; }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
    text-align: left;
  }

  label {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(245,245,240,0.8);
  }

  input {
    background: var(--color-charcoal);
    border: 1.5px solid rgba(245,245,240,0.12);
    border-radius: 4px;
    color: var(--color-off-white);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.8rem 1rem;
    width: 100%;
  }

  input:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(201,168,76,0.12);
  }

  input.invalid { border-color: var(--color-error); }

  .field-error { font-size: 0.8125rem; color: var(--color-error); min-height: 1.1em; }

  .primary-btn {
    background: var(--color-gold);
    color: var(--color-charcoal);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    border-radius: 4px;
    padding: 0.9rem 1.5rem;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  .primary-btn:hover:not(:disabled) { filter: brightness(1.1); transform: translateY(-1px); }
  .primary-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .sent-message { margin-top: 1.5rem; }

  .text-btn {
    background: none;
    border: none;
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8125rem;
    cursor: pointer;
    padding: 0.5rem;
  }

  .text-btn:hover { text-decoration: underline; }

  .form-banner {
    margin-top: 1rem;
    border-radius: 4px;
    padding: 0.875rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: left;
  }

  .form-banner--error { background: rgba(204,51,51,0.15); border: 1px solid rgba(204,51,51,0.4); color: #f08080; }
</style>
