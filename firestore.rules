rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Read access for the /admin page — one hardcoded owner email, not a
    // role/claim system (this is a single-operator site). Must match
    // src/config/admin.ts's ADMIN_EMAIL if that's ever changed.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'eus.java@gmail.com';
    }

    // Site-wide settings editable from /admin without a redeploy — currently
    // just config/classSchedule (the recurring free class's date/time/join
    // link). Any signed-in user can read it (the assessment funnel always
    // requires sign-in before it's needed); only the admin can write it.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Assessment results — created once by the signed-in user who completed
    // the assessment. No client update/delete; read is admin-only (the
    // /admin page), everyone else gets nothing back.
    match /leads/{leadId} {
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid
                     && request.resource.data.email is string
                     && request.resource.data.score is number;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Outgoing emails for the "Trigger Email" extension. Only the signed-in
    // user can queue an email addressed to their own account; the extension
    // (running with admin privileges) handles delivery and status updates.
    match /mail/{mailId} {
      allow create: if request.auth != null
                     && request.resource.data.to is list
                     && request.resource.data.to[0] == request.auth.token.email;
      allow read, update, delete: if false;
    }

    // Records of who registered for the free class — separate from `mail`
    // (the outgoing-email queue) so it's a clean, readable-by-nobody-but-
    // the-owner report. Create-only, no client read (reviewed via Firebase
    // Console, same pattern as `leads`).
    match /classRegistrations/{registrationId} {
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid
                     && request.resource.data.email is string
                     && request.resource.data.fullName is string
                     && request.resource.data.score is number;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Fields only Cloud Functions (Admin SDK, which bypasses these rules)
    // may write — clients must never grant themselves membership or forge
    // Stripe identifiers. See STRIPE_INTEGRATION.md.
    function touchesProtectedFields() {
      return request.resource.data.keys().hasAny([
        'membershipStatus', 'membershipUpdatedAt',
        'stripeCustomerId', 'stripeSubscriptionId'
      ]);
    }

    function updatesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'membershipStatus', 'membershipUpdatedAt',
        'stripeCustomerId', 'stripeSubscriptionId'
      ]);
    }

    // User profiles. Every signed-in user can read/create/update their own
    // profile, but membership/Stripe fields can only ever be set by the
    // Stripe webhook Cloud Function.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                     && !touchesProtectedFields();

      allow update: if request.auth != null && request.auth.uid == userId
                     && !updatesProtectedFields();
    }

    // Client <-> consultant messaging channel (paid portal feature).
    // Consultant-side replies are written via the Admin SDK, which bypasses
    // these rules; clients may only read/write their own conversation.
    match /conversations/{uid}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.sender == "client"
                     && request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // Public contact form submissions. Visitors are unauthenticated strangers
    // by design — the write is bounded by schema validation instead of an
    // auth requirement. No client read access; the consultant reviews these
    // in the Firebase Console.
    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.name is string
                     && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
                     && request.resource.data.email is string
                     && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                     && request.resource.data.country is string && request.resource.data.country.size() > 0
                     && request.resource.data.inquiry is string && request.resource.data.inquiry.size() > 0
                     && request.resource.data.message is string
                     && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 5000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
