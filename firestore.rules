rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Assessment results — created once by the signed-in user who completed
    // the assessment. No client read/update/delete.
    match /leads/{leadId} {
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid
                     && request.resource.data.email is string
                     && request.resource.data.score is number;
      allow read, update, delete: if false;
    }

    // Outgoing emails for the "Trigger Email" extension. Only the signed-in
    // user can queue an email addressed to their own account; the extension
    // (running with admin privileges) handles delivery and status updates.
    match /mail/{mailId} {
      allow create: if request.auth != null
                     && request.resource.data.to is list
                     && request.resource.data.to[0] == request.auth.token.email;
      allow read, update, delete: if false;
    }

    // User profiles. Every signed-in user can read/create/update their own
    // profile, but membershipStatus can only ever be set by the Stripe
    // webhook Cloud Function (Admin SDK bypasses these rules entirely) —
    // see STRIPE_INTEGRATION.md.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                     && !("membershipStatus" in request.resource.data);

      allow update: if request.auth != null && request.auth.uid == userId
                     && (!("membershipStatus" in request.resource.data)
                         || request.resource.data.membershipStatus == resource.data.membershipStatus);
    }

    // Client <-> consultant messaging channel (paid portal feature).
    // Consultant-side replies are written via the Admin SDK, which bypasses
    // these rules; clients may only read/write their own conversation.
    match /conversations/{uid}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.sender == "client";
      allow update, delete: if false;
    }

    // Public contact form submissions. Visitors are unauthenticated strangers
    // by design — the write is bounded by schema validation instead of an
    // auth requirement. No client read access; the consultant reviews these
    // in the Firebase Console.
    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.name is string
                     && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
                     && request.resource.data.email is string
                     && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                     && request.resource.data.country is string && request.resource.data.country.size() > 0
                     && request.resource.data.inquiry is string && request.resource.data.inquiry.size() > 0
                     && request.resource.data.message is string
                     && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
